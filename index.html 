<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Evolution Fitness – Editor de Banners</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<style>
/* === VARIÁVEIS (atualizadas pelo seletor de cor) === */
:root{
  --red:#C8102E; --gold:#F5C01A;
  --bg:#0A0A0A; --s1:#111; --s2:#1A1A1A; --s3:#222;
  --bd:rgba(255,255,255,.08); --mut:#777;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:var(--bg);color:#fff;height:100vh;overflow:hidden;display:flex;flex-direction:column}

/* HEADER */
header{background:var(--s1);border-bottom:1px solid var(--bd);padding:11px 16px;display:flex;align-items:center;gap:10px;flex-shrink:0}
.lm{width:28px;height:28px;background:var(--red);border-radius:6px;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:12px;flex-shrink:0;font-family:Impact,Arial}
header h1{font-size:14px;font-weight:700;font-family:Impact,Arial}
header p{color:var(--mut);font-size:10px}

/* TABS */
.tabs{background:var(--s1);border-bottom:1px solid var(--bd);padding:8px 12px 0;display:flex;gap:2px;overflow-x:auto;flex-shrink:0;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{padding:6px 11px;border-radius:5px 5px 0 0;border:1px solid transparent;background:transparent;color:var(--mut);font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap;transition:all .15s;font-family:Arial}
.tab.on{background:var(--bg);border-color:var(--bd);border-bottom-color:var(--bg);color:#fff;margin-bottom:-1px}

/* LAYOUT */
.layout{display:grid;grid-template-columns:272px 1fr;flex:1;overflow:hidden}

/* SIDEBAR */
.sb{background:var(--s1);border-right:1px solid var(--bd);overflow-y:auto;padding:10px;display:flex;flex-direction:column;gap:9px}
.blk{background:var(--s2);border:1px solid var(--bd);border-radius:8px;padding:11px}
.sec{font-size:9px;font-weight:700;letter-spacing:1.5px;color:var(--mut);text-transform:uppercase;margin-bottom:8px}
label{display:block;font-size:11px;font-weight:600;color:var(--mut);margin-bottom:3px;margin-top:7px}
label:first-of-type{margin-top:0}
input[type=text],input:not([type]),select,textarea{width:100%;background:var(--s3);border:1px solid var(--bd);border-radius:6px;padding:7px 9px;color:#fff;font-family:Arial;font-size:12px;outline:none;transition:border-color .15s;appearance:none}
textarea{resize:vertical;min-height:52px}
input:focus,select:focus,textarea:focus{border-color:var(--red)}
.r2{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.btn{width:100%;padding:8px;border:none;border-radius:6px;font-weight:700;font-size:12px;cursor:pointer;transition:opacity .15s;margin-top:6px;font-family:Arial}
.btn:hover{opacity:.85}
.br{background:var(--red);color:#fff}
.bgg{background:transparent;border:1px solid var(--bd);color:var(--mut)}
.bgg:hover{border-color:#fff;color:#fff}
.irow{display:flex;justify-content:space-between;align-items:center;background:var(--s3);border:1px solid var(--bd);border-radius:6px;padding:5px 8px;margin-bottom:4px;font-size:11px}
.ibadge{background:var(--red);color:#fff;font-size:8px;font-weight:700;padding:2px 5px;border-radius:3px;margin-right:4px}
.irm{background:none;border:none;color:var(--mut);cursor:pointer;font-size:12px}.irm:hover{color:var(--red)}
.enote{color:var(--mut);font-size:10px;text-align:center;padding:10px;border:1px dashed var(--bd);border-radius:6px}

/* Seletor de cores */
.color-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:4px}
.color-swatch{width:28px;height:28px;border-radius:50%;border:2px solid transparent;cursor:pointer;transition:border-color .15s;flex-shrink:0}
.color-swatch.on{border-color:#fff}
.color-custom{width:32px;height:28px;border-radius:6px;border:1px solid var(--bd);cursor:pointer;padding:0;background:none}

/* PANELS */
.panel{display:none}.panel.on{display:block}

/* PREVIEW */
.pv{background:#181818;overflow:auto;display:flex;flex-direction:column;align-items:center;padding:16px}
.ptb{display:flex;gap:8px;margin-bottom:12px;align-self:stretch;justify-content:flex-end}
.ptb button{padding:7px 16px;border-radius:6px;border:1px solid var(--bd);background:var(--s2);color:#fff;font-size:12px;font-weight:700;cursor:pointer;font-family:Arial}
.ptb button:hover{opacity:.8}
.ptb .dl{background:var(--gold);color:#000;border-color:var(--gold)}
.ptb button:disabled{opacity:.5;cursor:not-allowed}

/* === BANNERS BASE: 9×16 = 405×720px === */
.banner{
  display:none;
  width:405px; min-height:720px;
  flex-direction:column;
  overflow:hidden;
  position:relative;
  flex-shrink:0;
}
.banner.on{display:flex}
/* todos os textos do banner usam fontes do sistema */
.banner, .banner *{font-family:Impact,'Arial Black',Arial,sans-serif}

/* ═══════════════════════════════════
   B1 – HORÁRIOS
═══════════════════════════════════ */
#bH{background:#0D0D0D;border:3px solid var(--red);border-radius:12px}
.bH-top{background:var(--red);padding:12px 16px;display:flex;justify-content:space-between;align-items:center;flex-shrink:0}
.bH-nome{font-size:19px;letter-spacing:1px}
.bH-sub{font-size:9px;color:rgba(255,255,255,.7);letter-spacing:2px;font-family:Arial}
.bH-body{padding:14px 14px;flex:1;display:flex;flex-direction:column}
.bH-title{text-align:center;font-size:17px;letter-spacing:3px;margin-bottom:12px;color:rgba(255,255,255,.9)}
.bH-table{width:100%;border-collapse:collapse;flex:1}
.bH-table thead th{background:#1C1C1C;color:var(--gold);font-size:10px;letter-spacing:1px;padding:8px 3px;border:1px solid rgba(255,255,255,.07);text-align:center}
.bH-table thead th:first-child{color:rgba(255,255,255,.35);font-size:9px}
.bH-table tbody td{border:1px solid rgba(255,255,255,.05);padding:7px 3px;text-align:center;font-size:9px;color:rgba(255,255,255,.4);background:#0F0F0F}
.bH-table tbody td:first-child{font-size:11px;color:rgba(255,255,255,.8);background:#161616}
.bH-c{background:var(--red);color:#fff;font-size:9px;padding:3px 5px;border-radius:3px;display:inline-block}
.bH-foot{margin-top:auto;padding-top:10px;text-align:center;font-size:10px;color:rgba(255,255,255,.35);border-top:1px solid rgba(255,255,255,.05);font-family:Arial}
.bH-foot strong{color:var(--gold)}

/* ═══════════════════════════════════
   B2 – HOJE TEM AULA
═══════════════════════════════════ */
#bA{border:3px solid var(--red);border-radius:12px;overflow:hidden;background:#0D0D0D}
.bA-hd{background:linear-gradient(180deg,#111 0%,#0D0D0D 100%);padding:14px 16px 10px;text-align:center;border-bottom:1px solid rgba(255,255,255,.06)}
.bA-ct{font-size:8px;letter-spacing:3px;color:rgba(255,255,255,.35);font-family:Arial}
.bA-ac{font-size:13px;letter-spacing:4px;color:rgba(255,255,255,.9)}
.bA-np{font-size:9px;letter-spacing:2px;color:var(--red);font-family:Arial;font-weight:700;margin-top:2px}
.bA-hero{
  padding:24px 16px 16px;
  text-align:center;
  background:linear-gradient(180deg,#0D0D0D 0%,#1a0407 100%);
}
.bA-hj{
  font-size:52px;line-height:1;color:#fff;
  text-shadow:0 2px 10px rgba(0,0,0,.5);
}
/* CAIXA BRANCA COM AULA! — cor explícita para html2canvas */
.bA-ab{
  background:#ffffff;
  display:block;
  padding:6px 20px;
  margin:8px auto;
  width:fit-content;
}
.bA-at{
  font-size:54px;
  line-height:1.1;
  color:#C8102E !important;   /* cor explícita, não var(), para html2canvas */
  display:block;
  text-align:center;
}
.bA-vm{font-size:30px;color:rgba(255,255,255,.95);line-height:1.15;text-shadow:0 2px 8px rgba(0,0,0,.5)}
.bA-body{padding:14px 16px;flex:1;background:#0D0D0D}
.bA-mi{display:flex;flex-direction:column;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.06)}
.bA-mi:last-child{border:none}
.bA-mrow{display:flex;align-items:center;gap:8px;margin-bottom:3px}
.bA-mn{font-size:16px;color:#fff}
.bA-mb{background:var(--red);color:#fff;font-size:8px;padding:2px 6px;border-radius:3px;font-family:Arial}
.bA-md{font-size:10px;color:rgba(255,255,255,.45);font-family:Arial;line-height:1.4}
.bA-cta{background:var(--red);padding:14px 16px;text-align:center;flex-shrink:0}
.bA-ctat{font-size:16px;letter-spacing:1.5px}
.bA-ctap{font-size:14px;opacity:.9;font-family:Arial;font-weight:700}
.bA-ft{padding:9px 16px;display:flex;justify-content:space-between;font-size:9px;color:rgba(255,255,255,.3);font-family:Arial;background:#0D0D0D}

/* ═══════════════════════════════════
   B3 – FERIADO
═══════════════════════════════════ */
#bF{background:#0D0D0D;border:3px solid var(--red);border-radius:12px;overflow:hidden}
.bF-hd{background:#111;padding:14px 16px;text-align:center;border-bottom:2px solid var(--red)}
.bF-lbl{font-size:10px;letter-spacing:3px;color:rgba(255,255,255,.4)}
.bF-nome{font-size:20px;letter-spacing:1.5px}
.bF-body{padding:30px 20px;text-align:center;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(180deg,#0D0D0D,#180407)}
.bF-tit{font-size:48px;letter-spacing:3px;color:#fff;margin-bottom:4px}
.bF-datas{font-size:22px;color:var(--red);font-family:Arial;font-weight:700;margin:12px 0}
.bF-div{width:50px;height:2px;background:var(--red);margin:16px auto}
.bF-box{background:rgba(255,255,255,.05);border:2px solid var(--red);border-radius:12px;padding:18px;margin:10px 0;width:80%}
.bF-bx1{font-size:10px;letter-spacing:2px;color:rgba(255,255,255,.5);margin-bottom:6px}
.bF-bx2{font-size:42px;letter-spacing:1px;color:#fff}
.bF-obs{font-size:12px;color:rgba(255,255,255,.4);font-family:Arial;margin-top:16px}
.bF-cta{background:var(--red);padding:14px 16px;text-align:center;flex-shrink:0}
.bF-ft{padding:9px 16px;display:flex;justify-content:center;gap:16px;font-size:9px;color:rgba(255,255,255,.3);font-family:Arial;background:#0D0D0D}

/* ═══════════════════════════════════
   B4 – PLANOS
═══════════════════════════════════ */
#bP{background:#0f0f0f;border:3px solid var(--red);border-radius:12px;overflow:hidden}
.bP-hd{background:#111;padding:14px 16px;text-align:center;border-bottom:1px solid var(--bd)}
.bP-ct{font-size:9px;letter-spacing:2px;color:rgba(255,255,255,.35);font-family:Arial}
.bP-br{font-size:13px;letter-spacing:3px;color:rgba(255,255,255,.7)}
.bP-tt{font-size:30px;letter-spacing:2px}
.bP-sb{background:var(--red);display:inline-block;padding:3px 16px;margin-top:4px}
.bP-sb span{font-size:20px;letter-spacing:2px}
.bP-body{padding:16px;flex:1;display:flex;flex-direction:column;justify-content:center}
.bP-lb{text-align:center;font-size:10px;letter-spacing:2px;color:rgba(255,255,255,.4);font-family:Arial;margin-bottom:14px}
.bP-lb small{font-size:8px;display:block;color:rgba(255,255,255,.25)}
.bP-cards{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
.bP-card{background:var(--s2);border:1px solid var(--bd);border-radius:10px;padding:16px;text-align:center;position:relative}
.bP-card.dst{border-color:var(--red)}
.bP-mais{position:absolute;top:-9px;left:50%;transform:translateX(-50%);background:var(--red);color:#fff;font-size:8px;padding:2px 10px;border-radius:20px;white-space:nowrap;font-family:Arial}
.bP-pn{font-size:14px;letter-spacing:2px;color:rgba(255,255,255,.65)}
.bP-pc{font-size:9px;color:rgba(255,255,255,.35);font-family:Arial}
.bP-pr{font-size:38px;color:#fff;line-height:1.05}
.bP-rc{font-size:8px;letter-spacing:1px;color:rgba(255,255,255,.35);font-family:Arial}
.bP-nt{background:rgba(255,255,255,.04);border-radius:7px;padding:9px;text-align:center;font-size:9px;color:rgba(255,255,255,.3);font-family:Arial;margin-bottom:2px}
.bP-cta{background:var(--red);padding:14px 16px;text-align:center;flex-shrink:0}
.bP-ft{padding:8px 16px;display:flex;justify-content:center;gap:14px;font-size:9px;color:rgba(255,255,255,.3);font-family:Arial;background:#0f0f0f}

/* ═══════════════════════════════════
   B5 – INSTITUCIONAL
═══════════════════════════════════ */
#bI{border:3px solid rgba(255,255,255,.08);border-radius:12px;overflow:hidden;background:#1e1e1e}
.bI-hd{background:#1C1C1C;padding:14px 16px;text-align:center}
.bI-br{font-size:17px;letter-spacing:4px}
.bI-ct{font-size:8px;letter-spacing:2px;color:rgba(255,255,255,.3);font-family:Arial}
.bI-body{padding:20px;flex:1}
.bI-tt{font-size:44px;line-height:1.02;letter-spacing:.5px;margin-bottom:16px}
.bI-dv{width:36px;height:3px;background:var(--red);margin-bottom:14px}
.bI-ds{font-size:12px;color:rgba(255,255,255,.55);font-family:Arial;line-height:1.6;margin-bottom:14px}
.bI-ul{list-style:none}
.bI-ul li{font-size:12px;font-family:Arial;font-weight:700;color:rgba(255,255,255,.85);padding:6px 0 6px 14px;position:relative}
.bI-ul li::before{content:'●';color:var(--red);position:absolute;left:0;font-size:8px;top:9px}
.bI-cta{background:var(--red);padding:14px 20px}
.bI-cl{font-size:11px;letter-spacing:2px;color:rgba(255,255,255,.8);margin-bottom:5px}
.bI-ci{font-size:10px;color:rgba(255,255,255,.75);font-family:Arial;line-height:1.7}
.bI-tgs{background:#1C1C1C;padding:10px 20px;display:flex;justify-content:space-between}
.bI-tg{font-size:7px;letter-spacing:1.5px;color:rgba(255,255,255,.25);font-family:Arial}

/* ═══════════════════════════════════
   B6 – FERIADO + MASCOTE
═══════════════════════════════════ */
#bFM{background:#000;border:3px solid var(--red);border-radius:12px;overflow:hidden}
#bFM .fm-hd{background:#0a0a0a;padding:16px 18px 10px;text-align:center}
#bFM .fm-titulo{font-size:50px;color:#fff;line-height:1}
#bFM .fm-marca{font-size:28px;color:var(--red)}
#bFM .fm-foto{position:relative;line-height:0;flex:1}
#bFM .fm-foto img{width:100%;height:100%;object-fit:cover;display:block}
#bFM .fm-dates{
  position:absolute;top:8%;left:0;right:0;text-align:center;
  font-size:18px;color:var(--red);
  text-shadow:-1px -1px 0 #000,1px -1px 0 #000,-1px 1px 0 #000,1px 1px 0 #000;
}
#bFM .fm-caixa{
  position:absolute;bottom:5%;right:4%;
  background:rgba(0,0,0,.82);border:2px solid var(--red);
  border-radius:10px;padding:10px 14px;width:54%;text-align:center;
}
#bFM .fm-caixa-lbl{font-size:9px;color:rgba(255,255,255,.8);font-family:Arial;line-height:1.4}
#bFM .fm-caixa-hr{font-size:18px;color:#fff}
#bFM .fm-footer{background:rgba(0,0,0,.85);padding:10px 16px;text-align:center;font-size:11px;color:rgba(255,255,255,.8);font-family:Arial;flex-shrink:0}

/* ═══════════════════════════════════
   B7 – PLANOS + MASCOTE
═══════════════════════════════════ */
#bPM{background:#111;border:3px solid var(--red);border-radius:12px;overflow:hidden}
#bPM .pm-hd{background:#111;padding:12px 16px;text-align:center;border-bottom:1px solid rgba(255,255,255,.07)}
#bPM .pm-city{font-size:9px;letter-spacing:2px;color:rgba(255,255,255,.3);font-family:Arial}
#bPM .pm-brand{font-size:14px;letter-spacing:3px;color:rgba(255,255,255,.65)}
#bPM .pm-tt{font-size:26px;letter-spacing:1px;color:#fff}
#bPM .pm-sbwrap{margin-top:3px}
#bPM .pm-sb{background:#fff;display:inline-block;padding:2px 16px}
#bPM .pm-sb span{font-size:18px;letter-spacing:2px;color:var(--red)}
#bPM .pm-foto{background:var(--red);height:190px;display:flex;align-items:flex-end;justify-content:center;overflow:hidden}
#bPM .pm-foto img{height:220px;object-fit:contain;filter:drop-shadow(0 4px 14px rgba(0,0,0,.6))}
#bPM .pm-body{padding:12px 14px;flex:1;display:flex;flex-direction:column;justify-content:center}
#bPM .pm-label{text-align:center;font-size:10px;letter-spacing:2px;color:rgba(255,255,255,.4);font-family:Arial;margin-bottom:10px}
#bPM .pm-label small{font-size:8px;display:block;color:rgba(255,255,255,.25)}
#bPM .pm-cards{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:9px}
#bPM .pm-card{background:#1a1a1a;border:1px solid rgba(255,255,255,.08);border-radius:9px;padding:13px;text-align:center;position:relative}
#bPM .pm-card.dst{border-color:var(--red)}
#bPM .pm-mais{position:absolute;top:-9px;left:50%;transform:translateX(-50%);background:var(--red);color:#fff;font-size:8px;padding:2px 9px;border-radius:20px;white-space:nowrap;font-family:Arial}
#bPM .pm-pn{font-size:13px;letter-spacing:2px;color:rgba(255,255,255,.65)}
#bPM .pm-pc{font-size:9px;color:rgba(255,255,255,.35);font-family:Arial}
#bPM .pm-pr{font-size:34px;color:#fff;line-height:1.05}
#bPM .pm-cta{background:var(--red);padding:12px 16px;text-align:center;flex-shrink:0}
#bPM .pm-ctat{font-size:14px;letter-spacing:2px}
#bPM .pm-ctap{font-size:13px;font-family:Arial;font-weight:700;opacity:.9}
#bPM .pm-ft{padding:7px 16px;display:flex;justify-content:center;gap:12px;font-size:9px;color:rgba(255,255,255,.3);font-family:Arial;background:#111}

/* ═══════════════════════════════════
   B8 – COPA CAMPEÃO
═══════════════════════════════════ */
#bCO{background:#000;border:3px solid var(--gold);border-radius:12px;overflow:hidden}
#bCO .co-img{width:100%;height:100%;object-fit:cover;position:absolute;top:0;left:0;display:block}
#bCO .co-layer{
  position:relative;z-index:1;
  display:flex;flex-direction:column;
  padding:28px 22px 20px;
  min-height:720px;
}
#bCO .co-sm{font-size:10px;letter-spacing:2px;font-family:Arial;font-weight:700;color:rgba(255,255,255,.85);text-shadow:0 1px 5px #000}
#bCO .co-title{font-size:52px;color:#fff;line-height:.9;margin-top:4px;text-shadow:0 2px 14px #000}
#bCO .co-sub{font-size:15px;font-family:Arial;margin-top:10px;color:rgba(255,255,255,.9);line-height:1.4;text-shadow:0 1px 7px #000}
#bCO .co-space{flex:1}
#bCO .co-btn{background:var(--gold);color:#000;font-size:14px;font-weight:900;font-family:'Arial Black',Arial;padding:12px 26px;border-radius:30px;display:inline-block;box-shadow:0 3px 12px rgba(0,0,0,.6)}
#bCO .co-ph{font-size:11px;color:rgba(255,255,255,.7);font-family:Arial;margin-top:10px;text-align:center;text-shadow:0 1px 5px #000}

/* ═══════════════════════════════════
   GALERIA TEMPLATES
═══════════════════════════════════ */
.tpl-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.tpl-card{position:relative;border-radius:7px;overflow:hidden;cursor:pointer;border:2px solid transparent;transition:border-color .15s}
.tpl-card:hover{border-color:var(--gold)}
.tpl-card img{width:100%;display:block}
.tpl-card .tpl-lbl{position:absolute;bottom:0;left:0;right:0;background:rgba(0,0,0,.8);font-size:9px;font-family:Arial;color:#fff;padding:4px 6px;text-align:center;line-height:1.3}
.tpl-card.sel{border-color:var(--red)}
.tpl-card.sel::after{content:'✓';position:absolute;top:5px;right:5px;background:var(--red);color:#fff;font-size:9px;font-family:Arial;font-weight:700;padding:2px 6px;border-radius:3px}
.tpl-pw{display:flex;flex-direction:column;align-items:center;gap:12px;width:100%}
.tpl-pw img{max-width:405px;width:100%;border-radius:10px;border:2px solid rgba(200,16,46,.4)}
.tpl-dl{background:var(--gold);color:#000;border:none;font-size:15px;font-weight:900;font-family:Arial;padding:13px 0;border-radius:9px;width:100%;max-width:405px;cursor:pointer}
.tpl-dl:hover{opacity:.85}
